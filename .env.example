# HackTUI environment template.
#
#   cp .env.example .env    then edit, then:  set -a; . ./.env; set +a
#
# Every runbook under docs/ assumes these are exported. .env itself is gitignored
# (.gitignore:26) and must never be committed.

# --- PostgreSQL -------------------------------------------------------------
# Required whenever HACKTUI_START_REPO=true. There is no safe default password;
# production config validation rejects the demo values outright.
HACKTUI_DB_USER=hacktui
HACKTUI_DB_PASS=change-me
HACKTUI_DB_HOST=localhost
HACKTUI_DB_PORT=5432
HACKTUI_DB_NAME=hacktui_dev

# --- Runtime gating ---------------------------------------------------------
# Default is false: the repo does not start and the system runs in safe_no_repo
# mode. Set true only when the database above is reachable and migrated.
#
# In a production release (MIX_ENV=prod) this variable MUST be set explicitly: `false`
# boots safe mode with no database, `true` starts the repo and requires the HACKTUI_DB_*
# values above to be real (demo defaults and a localhost hostname are refused). Unset is
# refused with a message naming both choices.
HACKTUI_START_REPO=false

# Comma-separated opt-ins. Both default to empty (disabled).
# HACKTUI_AGENT_BACKENDS=jido
# HACKTUI_COLLAB_PROVIDERS=slack

# --- Distributed operation (optional) ---------------------------------------
# Erlang node name of the hub when running the sensor on a separate host.
# Distribution is cookie-authenticated and grants remote code execution to any
# peer that knows the cookie: generate one per deployment, never reuse a literal.
#   Erlang cookie:  openssl rand -base64 32
# HACKTUI_HUB_NODE=hub@127.0.0.1

# --- MCP --------------------------------------------------------------------
# Set by bin/hacktui-mcp. Suppresses the default logger handler so log output
# cannot corrupt the JSON-RPC stream on stdout. Do not set this by hand.
# HACKTUI_MCP_STDIO=1
